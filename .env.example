# Gate-routed worker runtime (constellation-node-sdk)
L9_ENVIRONMENT=local
L9_NODE_NAME=l9-example-pkg
L9_SERVICE_NAME=l9-example-pkg
L9_SERVICE_VERSION=0.1.0
L9_ALLOWED_ACTIONS=example
L9_ALLOWED_PACKET_TYPES=request
L9_REQUIRE_SIGNATURE=false
L9_DEV_MODE=true

# Gate egress (required for registration / follow-up dispatch)
GATE_URL=
GATE_NODE_SPEC_PATH=spec.yaml

# Bind (containers should set HOST=0.0.0.0)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Optional OTLP export when using `make obs-up` (off by default — collector optional)
# OTEL_SERVICE_NAME=l9-example-pkg
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
