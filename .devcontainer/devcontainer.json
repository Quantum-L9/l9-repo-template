{
  "name": "l9-repo-template",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": "pip install uv --quiet && uv sync --extra dev",
  "postCreateCommand": "uv run pre-commit install || true",
  "updateContentCommand": "uv sync --extra dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-vscode.makefile-tools",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/l9-repo-template",
  "containerEnv": {
    "PYTHONPATH": "/workspaces/l9-repo-template/src"
  }
}
