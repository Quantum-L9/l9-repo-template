{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9://repo-birth/handoff/v1",
  "title": "L9 Repository Birth Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_digest",
    "request_digest",
    "repository",
    "package",
    "description",
    "private",
    "repo_class",
    "template",
    "organization",
    "payload",
    "prepared",
    "prepare_receipt",
    "bootstrap_timeout",
    "profile",
    "receipt"
  ],
  "properties": {
    "schema": {"const": "l9.repo-birth-handoff/v1"},
    "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "package": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "private": {"type": "boolean"},
    "repo_class": {"type": "string", "minLength": 1},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "version"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source"],
      "properties": {
        "mode": {"enum": ["none", "additive", "authoritative"]},
        "source": {"type": "object"}
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_commit_sha",
        "root_tree_sha",
        "root_path",
        "contents_manifest_sha256",
        "permanent_receipt_digest"
      ],
      "properties": {
        "root_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "root_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "root_path": {"type": "string", "minLength": 1},
        "contents_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "permanent_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "prepare_receipt": {"type": "string", "minLength": 1},
    "bootstrap_timeout": {"type": "integer", "minimum": 1},
    "profile": {"type": "object"},
    "receipt": {"type": "object"}
  }
}
