{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/ideaos/schemas/runtime_capabilities.schema.json",
  "title": "IdeaOSRuntimeCapabilities",
  "description": "What this runtime can be asked to do, with the schema digests a caller can pin against. Shape is pinned by runtime_capabilities() in runtime.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_version",
    "canonical_ingress",
    "operations",
    "utilities",
    "handoffs"
  ],
  "properties": {
    "schema": { "const": "ideaos.runtime-capabilities/v1" },
    "runtime_version": { "type": "string", "minLength": 1 },
    "canonical_ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library",
        "cli",
        "request_schema",
        "request_schema_digest",
        "receipt_schema",
        "receipt_schema_digest"
      ],
      "properties": {
        "library": { "const": "ideaos.IdeaOSRuntime.execute" },
        "cli": { "const": "ideaos run" },
        "request_schema": { "const": "ideaos_run_request.schema.json" },
        "request_schema_digest": { "$ref": "#/$defs/digest" },
        "receipt_schema": { "const": "ideaos_run_receipt.schema.json" },
        "receipt_schema_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "input_schema",
          "input_schema_digest",
          "output_schema",
          "output_schema_digest",
          "provider_required",
          "allowed_options",
          "side_effect_class",
          "deterministic"
        ],
        "properties": {
          "mode": { "type": "string", "minLength": 1 },
          "input_schema": { "$ref": "#/$defs/schema_name" },
          "input_schema_digest": { "$ref": "#/$defs/digest" },
          "output_schema": { "$ref": "#/$defs/schema_name" },
          "output_schema_digest": { "$ref": "#/$defs/digest" },
          "provider_required": { "type": "boolean" },
          "allowed_options": { "type": "array", "items": { "type": "string" } },
          "side_effect_class": { "type": "string", "enum": ["none", "external_read"] },
          "deterministic": { "type": "boolean" }
        }
      }
    },
    "utilities": { "type": "array", "items": { "type": "string" } },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "schema_name", "schema_digest", "consumer_role"],
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "schema_name": { "$ref": "#/$defs/schema_name" },
          "schema_digest": { "$ref": "#/$defs/digest" },
          "consumer_role": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_name": { "type": "string", "pattern": "^[a-z_]+\\.schema\\.json$" }
  }
}
