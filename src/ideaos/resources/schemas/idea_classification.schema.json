{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/ideaos/schemas/idea_classification.schema.json",
  "title": "IdeaClassification",
  "description": "An idea presented for routing. The runtime's `route` mode reads this and answers which canonical lifecycle stage the idea belongs in next.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "idea_id",
    "statement",
    "stage_evidence"
  ],
  "properties": {
    "schema": {
      "const": "ideaos.idea-classification/v1"
    },
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "domain_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which lifecycle artifacts the caller actually holds. Routing is a function of evidence, never of confidence: an idea advances because the artifact for the prior stage exists, not because it seems ready.",
      "properties": {
        "has_developed_idea_dossier": {
          "type": "boolean",
          "default": false
        },
        "has_expansion_packet": {
          "type": "boolean",
          "default": false
        },
        "has_ready_expansion_gate_receipt": {
          "type": "boolean",
          "default": false
        },
        "has_decision_node_input": {
          "type": "boolean",
          "default": false
        },
        "has_authorizing_decision_packet": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
