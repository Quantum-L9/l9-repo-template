{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/ideaos/schemas/idea_execution_packet.schema.json",
  "title": "IdeaExecutionPacket",
  "description": "The execute stage's input, handed to the external execution topology compiler. `status` is the field runtime.py line 82 branches on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "idea_id",
    "status",
    "input_digest"
  ],
  "properties": {
    "schema": {
      "const": "ideaos.idea-execution-packet/v1"
    },
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "execution_authorized",
        "no_execution_required",
        "blocked"
      ]
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
