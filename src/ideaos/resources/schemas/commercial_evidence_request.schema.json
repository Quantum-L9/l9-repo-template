{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/ideaos/schemas/commercial_evidence_request.schema.json",
  "title": "CommercialEvidenceRequest",
  "description": "Questions put to an external commercial research provider. This is the runtime's only non-deterministic operation and its only external read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "idea_id",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "ideaos.commercial-evidence-request/v1"
    },
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
